DB_PASSWORD=your_strong_password
DATABASE_URL=postgresql+asyncpg://qorgau_user:your_strong_password@db/qorgau_dlp
REDIS_URL=redis://redis:6379/0
SECRET_KEY=your_very_secret_key_min_32_chars
GRAFANA_PASSWORD=admin_password

# Telegram алерты
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Домен сервера (для HTTPS)
SERVER_DOMAIN=your-server.kz

# Настройки агентов
AGENT_TOKEN=secret_agent_token_here

# UI-консоль: учётка первого администратора (создаётся при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=qorgau_admin_2024

# SIEM JSON-webhook (опционально)
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=

# ОЦИБ / SIEM по Syslog + CEF (Единые требования ИБ). Пусто = выкл
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTO=udp

# Теневое копирование (доказательная база)
SHADOW_DIR=/app/shadow
SHADOW_RETENTION_DAYS=365
SHADOW_MAX_MB=50
