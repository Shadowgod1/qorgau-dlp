# PostgreSQL
DB_PASSWORD=replace_with_strong_db_password
DATABASE_URL=postgres://qorgau_user:replace_with_strong_db_password@db:5432/qorgau_dlp

# Security & Auth
SECRET_KEY=replace_with_random_secret_min_32_characters_long
JWT_EXPIRE_MIN=480
AGENT_TOKEN=replace_with_strong_agent_token
CORS_ORIGINS=http://localhost,http://localhost:5173

# Initial admin operator (seeded only if operators table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password

# Storage & Retention (days)
SCREENSHOTS_DIR=/app/screenshots
SCREENSHOTS_RETENTION_DAYS=30
SHADOW_DIR=/app/shadow
SHADOW_RETENTION_DAYS=365
SHADOW_MAX_MB=50
AUDIO_DIR=/app/audio
AUDIO_RETENTION_DAYS=30
AUDIO_MAX_MB=20
WEBCAM_DIR=/app/webcam_photos
WEBCAM_RETENTION_DAYS=30
MEDIA_MAX_MB=10
DATA_RETENTION_DAYS=365
OCR_CONCURRENCY=2

# Optional Telegram alerts (PII masked)
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Optional SIEM JSON Webhook
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=

# Optional ОЦИБ / SIEM Syslog + ArcSight CEF:0
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTO=udp
